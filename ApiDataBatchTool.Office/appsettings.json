{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Api": {
    "HttpClientName": "OfficeApi",
    "BaseUrl": "https://office-api.example.com/v1/offices",
    "PageSize": 10000,
    "TimeoutSeconds": 30,
    "RetryCount": 3
  },
  "Database": {
    "ConnectionStringKey": "OFFICE_DB_PROD",
    "CommandTimeoutSeconds": 300,
    "TargetTableName": "OFFICE_MASTER",
    "PostMergeProcedureName": "PKG_OFFICE.PROC_POST_MERGE"
  },
  "Batch": {
    "BatchName": "OfficeBatchTool",
    "MergeBatchSize": 1000
  },
  "Cid": {
    "BatFilePath": "Scripts/GetCid.bat",
    "BatArguments": "OFFICE"
  },
  "Mail": {
    "Enabled": true,
    "Recipient": "alert@example.com",
    "Subject": "[Office] バッチ処理失敗通知"
  }
}
