{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Api": {
    "BaseUrl": "https://office-api-dev.example.com",
    "Endpoint": "/v1/offices",
    "PageSize": 100,
    "TimeoutSeconds": 60,
    "RetryCount": 1
  },
  "Database": {
    "ConnectionStringKey": "OFFICE_DB_DEV",
    "CommandTimeoutSeconds": 60,
    "TargetTableName": "OFFICE_MASTER",
    "PostMergeProcedureName": "PKG_OFFICE.PROC_POST_MERGE"
  },
  "Batch": {
    "BatchName": "OfficeBatchTool_DEV",
    "MergeBatchSize": 100
  },
  "Cid": {
    "BatFilePath": "Scripts/GetCid.bat",
    "BatArguments": "OFFICE"
  }
}
