{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Api": {
    "HttpClientName": "BusinessCardApi",
    "BaseUrl": "https://businesscard-api.example.com/v1/business-cards",
    "PageSize": 10000,
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "IsOverseas": false
  },
  "Database": {
    "ConnectionStringKey": "BUSINESSCARD_DB_PROD",
    "CommandTimeoutSeconds": 300,
    "TargetTableName": "BUSINESS_CARD_MASTER",
    "PostMergeProcedureName": "PKG_BUSINESS_CARD.PROC_POST_MERGE"
  },
  "Batch": {
    "BatchName": "BusinessCardBatchTool",
    "MergeBatchSize": 1000
  },
  "Cid": {
    "BatFilePath": "Scripts/GetCid.bat",
    "BatArguments": "BUSINESSCARD"
  },
  "MailNotification": {
    "Enabled": true,
    "Development": {
      "Recipient": "dev-team@example.com",
      "Subject": "[名刺連携] バッチ処理エラー通知",
      "BodyTemplate": "バッチ処理でエラーが発生しました。\n\nバッチ名: {BatchName}\n終了コード: {ExitCode}\n実行日時: {DateTime}\n\n詳細はログを確認してください。"
    },
    "Operation": {
      "Recipient": "operation-se@example.com",
      "Subject": "[名刺連携] バッチ処理連続失敗通知（対応依頼）",
      "BodyTemplate": "バッチ処理が連続で失敗しています。\n\nバッチ名: {BatchName}\n連続失敗回数: {FailureCount}\n終了コード: {ExitCode}\n実行日時: {DateTime}\n\n至急確認をお願いします。"
    }
  },
  "ExecutionHistory": {
    "FilePath": "execution_history.json",
    "ConsecutiveFailureThreshold": 2
  }
}
