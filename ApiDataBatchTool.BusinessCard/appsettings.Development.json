{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Api": {
    "HttpClientName": "BusinessCardApi",
    "BaseUrl": "https://businesscard-api-dev.example.com",
    "Endpoint": "/v1/business-cards",
    "PageSize": 100,
    "TimeoutSeconds": 60,
    "RetryCount": 1,
    "IsOverseas": false
  },
  "Database": {
    "ConnectionStringKey": "BUSINESSCARD_DB_DEV",
    "CommandTimeoutSeconds": 60,
    "TargetTableName": "BUSINESS_CARD_MASTER",
    "PostMergeProcedureName": "PKG_BUSINESS_CARD.PROC_POST_MERGE"
  },
  "Batch": {
    "BatchName": "BusinessCardBatchTool_DEV",
    "MergeBatchSize": 100
  },
  "Cid": {
    "BatFilePath": "Scripts/GetCid.bat",
    "BatArguments": "BUSINESSCARD"
  }
}
